{
  "uid": "nightshift-overview",
  "title": "NightShift - Target overview",
  "tags": [
    "nightshift"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "gateway|orders|payments|inventory",
        "query": "gateway,orders,payments,inventory",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Deploys",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "nightshift-ops"
        },
        "enable": true,
        "iconColor": "#F2495C",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT deployed_at AS time, service || ' ' || coalesce(previous_version, '?') || ' -> ' || version || ' (' || initiated_by || ')' AS text, 'deploy,' || service AS tags FROM ops.deploys WHERE $__timeFilter(deployed_at)"
        }
      },
      {
        "name": "Config changes",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "nightshift-ops"
        },
        "enable": true,
        "iconColor": "#FF9830",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT changed_at AS time, service || ' ' || key || ': ' || coalesce(old_value, '?') || ' -> ' || new_value || ' by ' || changed_by AS text, 'config,' || service AS tags FROM ops.settings_history WHERE kind = 'CONFIG' AND $__timeFilter(changed_at)"
        }
      },
      {
        "name": "Flag changes",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "nightshift-ops"
        },
        "enable": true,
        "iconColor": "#B877D9",
        "target": {
          "refId": "Anno",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT changed_at AS time, service || ' flag ' || key || ': ' || coalesce(old_value, '?') || ' -> ' || new_value || ' by ' || changed_by AS text, 'flag,' || service AS tags FROM ops.settings_history WHERE kind = 'FLAG' AND $__timeFilter(changed_at)"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Traffic and errors",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_route!~\"/actuator.*|/admin.*|/internal.*\"}[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx error rate",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_route!~\"/actuator.*|/admin.*|/internal.*\",http_response_status_code=~\"5..\"}[1m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "description": "HighErrorRate fires above 5 %",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_route!~\"/actuator.*|/admin.*|/internal.*\",http_response_status_code=~\"5..\"}[2m])) / sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_route!~\"/actuator.*|/admin.*|/internal.*\"}[2m]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency",
      "description": "HighLatencyP95 fires above 300 ms",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service\",http_route!~\"/actuator.*|/admin.*|/internal.*\"}[1m])))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Runtime",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "JVM heap used",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (jvm_memory_used_bytes{service_name=~\"$service\",jvm_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (jvm_memory_limit_bytes{service_name=~\"$service\",jvm_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}} max"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Restarts (process starts, 10 m window)",
      "description": "Includes deploy restarts. ServiceRestarting fires at >= 2 restarts of one version in 10 m.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (changes(max by (service_name) (process_start_time_seconds{service_name=~\"$service\"})[10m:15s]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "DB pool: connections in use / pending",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name) (db_client_connections_usage{service_name=~\"$service\",state=\"used\"})",
          "legendFormat": "{{service_name}} used"
        },
        {
          "refId": "B",
          "expr": "sum by (service_name) (db_client_connections_pending_requests{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} pending"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Downstream call p95 (HTTP client)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_name, server_address, le) (rate(http_client_request_duration_seconds_bucket{service_name=~\"$service\",server_address!=\"chaos-controller\"}[1m])))",
          "legendFormat": "{{service_name}} -> {{server_address}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Changes, logs and traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Recent deploys, config and flag changes",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nightshift-ops"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT deployed_at AS \"time\", 'deploy' AS kind, service, 'version' AS key, previous_version AS old, version AS new, initiated_by AS who, status AS detail FROM ops.deploys WHERE $__timeFilter(deployed_at) UNION ALL SELECT changed_at, lower(kind), service, key, old_value, new_value, changed_by, reason FROM ops.settings_history WHERE $__timeFilter(changed_at) ORDER BY 1 DESC LIMIT 100"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "time",
            "desc": true
          }
        ]
      }
    },
    {
      "type": "logs",
      "title": "Errors and warnings",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"} | detected_level=~\"(?i)error|severe|fatal|warn|warning\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "type": "table",
      "title": "Recent error traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{resource.service.name=~\"$service\" && status=error}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    }
  ]
}
