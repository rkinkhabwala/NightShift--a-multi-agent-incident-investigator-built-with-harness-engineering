      {
        "deploy": null,
        "config": {
          "service": "orders",
          "key": "orders.db.pool.timeout-ms",
          "value": "3000",
          "changedBy": "dana.ops",
          "reason": "revert"
        },
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
