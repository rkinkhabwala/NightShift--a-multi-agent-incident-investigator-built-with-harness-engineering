    "fault": {
      "type": "config_change",
      "service": "orders",
      "key": "orders.db.pool.max"
    },
    "inject": [
      {
        "deploy": null,
        "config": {
          "service": "orders",
          "key": "orders.db.pool.timeout-ms",
          "value": "250",
          "changedBy": "dana.ops",
          "reason": "fail fast on DB waits"
        },
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
      },
      {
        "deploy": null,
        "config": {
          "service": "orders",
          "key": "orders.db.pool.max",
          "value": "1",
          "changedBy": "dana.ops",
          "reason": "free DB connections for the reporting job"
        },
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
      }
    ],
    "reset": [
      {
        "deploy": null,
        "config": {
          "service": "orders",
          "key": "orders.db.pool.max",
          "value": "10",
          "changedBy": "dana.ops",
          "reason": "revert"
        },
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
