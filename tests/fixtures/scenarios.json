          "name": "inventory.leak"
        },
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
      },
      {
        "deploy": null,
        "config": null,
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": {
          "service": "inventory",
          "name": "inventory.leak.kb-per-reservation"
        },
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
