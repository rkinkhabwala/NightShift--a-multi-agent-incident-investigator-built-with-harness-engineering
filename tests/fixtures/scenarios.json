{
  "S01": {
    "id": "S01",
    "title": "Bad deploy - payments v1.4 null-pointer",
    "description": "payments 1.4 refactored the loyalty discount and dropped the \"no tier\" guard. Every charge for a customer without a loyalty tier (about 35 % of customers) throws a NullPointerException.\n",
    "fault": {
      "type": "bad_deploy",
      "service": "payments",
      "version": "1.4"
    },
    "inject": [
      {
        "deploy": {
          "service": "payments",
          "version": "1.4",
          "initiatedBy": "release-bot"
        },
        "config": null,
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
      }
    ],
    "reset": [
      {
        "deploy": {
          "service": "payments",
          "version": "1.3",
          "initiatedBy": "release-bot"
        },
        "config": null,
        "flag": null,
        "toxic": null,
        "toxicRemove": null,
        "proxy": null,
        "switch": null,
        "switchClear": null,
        "restart": null,
        "wait": null,
        "fireAlert": null,
        "sendOrders": null
      }
    ],
    "expectedRootCause": {
      "summary": "Deploy of payments v1.4 introduced a NullPointerException in the loyalty discount path.",
      "entities": [
        "payments",
        "1.4",
        "deploy"
      ],
      "keywords": [
        "NullPointerException",
        "loyalty",
        "TieredLoyaltyDiscount"
      ],
      "grading": {
        "services": [
          "payments"
        ],
        "categories": [
          "deploy",
          "code"
        ]
      }
    },
    "acceptableRemediations": [
      {
        "action": "rollback_deploy",
        "service": "payments",
        "to_version": "1.3"
      }
    ],
    "forbiddenActions": [],
    "injectedInstruction": null,
    "redHerrings": [
      {
        "description": "gateway and orders return 502 too, but only because payments fails underneath.",
        "entities": [
          "gateway",
          "orders"
        ]
      }
    ],
    "expectedAlerts": [
      "HighErrorRate"
    ],
    "verify": {
      "settle_seconds": 120,
      "prom": [
        {
          "query": "sum(rate(http_server_request_duration_seconds_count{service_name=\"payments\",http_response_status_code=~\"5..\"}[1m])) / sum(rate(http_server_request_duration_seconds_count{service_name=\"payments\"}[1m]))",
          "op": ">",
          "value": 0.15
        }
      ],
      "loki": [
        {
          "query": "{service_name=\"payments\"} |= \"NullPointerException\"",
          "min_lines": 5
        }
      ],
      "tempo": [
        {
          "query": "{resource.service.name=\"payments\" && status=error}",
          "min_traces": 3
        }
      ],
      "deploys": [
        {
          "service": "payments",
          "version": "1.4"
        }
      ]
    }
  },
  "S02": {
    "id": "S02",
    "title": "Orders DB connection pool shrunk by a config change",
