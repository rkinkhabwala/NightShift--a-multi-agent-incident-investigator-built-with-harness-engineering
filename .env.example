# Copy to .env for local development. These are throwaway local-only placeholders;
# never put real credentials here.
COMPOSE_PROJECT_NAME=nightshift

POSTGRES_USER=nightshift
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nightshift

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# Load generator: requests per second (constant arrival rate)
K6_RATE=8

# Read-only Postgres role used by Grafana for deploy/config/flag annotations
GRAFANA_DB_PASSWORD=change-me-local-only
